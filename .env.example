# Copy this file to `.env` (repo root). Both the API (Windows or WSL) and the
# Prisma CLI load it. Containers run under WSL but WSL2 forwards their ports to
# localhost on either side, so `localhost` works from Windows and from WSL.

# Postgres — matches docker-compose.yml (user/password/db: erp).
# NOTE: this WSL machine already runs its own Postgres on 5432, so the container
# is published on 15432 instead (see docker-compose.yml).
DATABASE_URL=postgresql://erp:erp@localhost:15432/erp

# Redis — refresh tokens, permission cache (Stage B3+). Same remap: 16379.
REDIS_URL=redis://localhost:16379

# API server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth (used from Phase B3 on)
JWT_SECRET=dev-only-secret-change-me
