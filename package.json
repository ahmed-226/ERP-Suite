{
  "name": "erp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Traditional ERP suite (learning project) - client-first build",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "infra:up": "wsl -e bash -lc \"cd /mnt/d/SW/repos/ERP && docker compose up -d\"",
    "infra:down": "wsl -e bash -lc \"cd /mnt/d/SW/repos/ERP && docker compose down\"",
    "infra:ps": "wsl -e bash -lc \"cd /mnt/d/SW/repos/ERP && docker compose ps\"",
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
